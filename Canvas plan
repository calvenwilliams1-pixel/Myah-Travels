export interface CanvasElement {
  id: string;
  name: string;                    // Auto-generated: "Text 1", "Image 2"
  type: ElementType;
  x: number;
  y: number;
  width: number;
  height: number;
  rotation: number;                // degrees
  zIndex: number;
  locked: boolean;
