.env
.env.local
.env.production

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Misc
.DS_Store
*.pem
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.vercel
*.log

# Backups
backups/

# Uploads: files are served through /api/uploads with auth checks.
# Never store runtime uploads in public/ or track them in git.
public/uploads/*
!public/uploads/.gitkeep
data/uploads/*
!data/uploads/.gitkeep
