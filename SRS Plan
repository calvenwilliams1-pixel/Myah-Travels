  VALUES (new.id, new.title, new.content, 'guide', new.id);
END;

CREATE TRIGGER guides_au AFTER UPDATE ON guides BEGIN
  UPDATE search_index SET title = new.title, content = new.content
  WHERE content_type = 'guide' AND content_id = new.id;
END;

CREATE TRIGGER guides_ad AFTER DELETE ON guides BEGIN
