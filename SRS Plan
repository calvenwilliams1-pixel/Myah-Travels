);

-- Posts triggers
CREATE TRIGGER posts_ai AFTER INSERT ON posts BEGIN
  INSERT INTO search_index (rowid, title, content, content_type, content_id)
  VALUES (new.id, new.title, new.content, 'post', new.id);
END;

CREATE TRIGGER posts_au AFTER UPDATE ON posts BEGIN
  UPDATE search_index SET title = new.title, content = new.content
  WHERE content_type = 'post' AND content_id = new.id;
END;

CREATE TRIGGER posts_ad AFTER DELETE ON posts BEGIN
  DELETE FROM search_index WHERE content_type = 'post' AND content_id = old.id;
END;

-- Guides triggers
CREATE TRIGGER guides_ai AFTER INSERT ON guides BEGIN
